{
  "name": "ziggy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ziggy": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src extensions tooling",
    "fmt": "oxfmt \"src/**/*.ts\" \"!src/generated/**\" \"!src/adapters/pi/generated/**\" \"extensions/**/*.ts\" \"extensions/**/*.mjs\" \"tooling/**/*.mjs\"",
    "generate:catalog": "bun tooling/generate-builtin-catalog.mjs",
    "check:catalog": "bun tooling/generate-builtin-catalog.mjs --check",
    "test": "bun test ./src ./extensions && bun run test:helpers",
    "test:helpers": "bun run --cwd extensions/here-now test",
    "check": "oxfmt --check \"src/**/*.ts\" \"!src/generated/**\" \"!src/adapters/pi/generated/**\" \"extensions/**/*.ts\" \"extensions/**/*.mjs\" \"tooling/**/*.mjs\" && bun run lint && bun run typecheck && bun run check:catalog"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.82.0",
    "effect": "4.0.0-beta.99",
    "@effect/platform-bun": "4.0.0-beta.99"
  },
  "devDependencies": {
    "@effect/tsgo": "0.21.0",
    "bun-types": "1.3.14",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2"
  }
}
