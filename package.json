{
  "name": "ziggy",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "ziggy": "./src/main.ts"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p clients/example-web/tsconfig.json",
    "lint": "oxlint src test extensions tooling",
    "fmt": "oxfmt \"src/**/*.ts\" \"!src/generated/**\" \"!src/adapters/pi/generated/**\" \"test/**/*.ts\" \"extensions/**/*.ts\" \"extensions/**/*.mjs\" \"tooling/**/*.mjs\" \"tooling/**/*.ts\"",
    "generate:catalog": "bun tooling/generate-builtin-catalog.mjs",
    "check:catalog": "bun tooling/generate-builtin-catalog.mjs --check",
    "generate:pi-docs": "bun tooling/generate-pi-docs.mjs",
    "check:pi-docs": "bun tooling/generate-pi-docs.mjs --check",
    "build:binary": "bun tooling/build-standalone-executable.mjs",
    "build:binary:dev": "bun tooling/build-standalone-executable.mjs --development",
    "smoke:binary": "bun tooling/smoke-standalone-executable.mjs",
    "smoke:binary:dev": "bun tooling/smoke-standalone-executable.mjs --allow-development --artifact /tmp/ziggy-standalone-dev/ziggy",
    "test": "bun test ./test ./extensions ./tooling && bun run test:helpers",
    "test:helpers": "bun run --cwd extensions/here-now test",
    "check": "oxfmt --check \"src/**/*.ts\" \"!src/generated/**\" \"!src/adapters/pi/generated/**\" \"test/**/*.ts\" \"extensions/**/*.ts\" \"extensions/**/*.mjs\" \"tooling/**/*.mjs\" \"tooling/**/*.ts\" && bun run lint && bun run typecheck && bun run check:catalog && bun run check:pi-docs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@effect/platform-bun": "4.0.0-beta.99",
    "effect": "4.0.0-beta.99"
  },
  "devDependencies": {
    "@effect/tsgo": "0.21.0",
    "bun-types": "1.3.14",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2"
  }
}
