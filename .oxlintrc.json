{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "extensions/computer-use/dist/**",
    "extensions/computer-use/native/**",
    "extensions/computer-use/scripts/**",
    "vendor/effect/**",
    "src/generated/**",
    "src/adapters/pi/generated/**"
  ],
  "jsPlugins": ["./tooling/oxlint/ziggy-plugin.mjs", "./tooling/oxlint/effect-plugin.mjs"],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "ziggy-effect/no-conditional-tests": "error",
    "ziggy-effect/no-effect-escape-hatch": "error",
    "ziggy-effect/no-effect-execution-boundary": "error",
    "ziggy-effect/no-error-constructor": "error",
    "ziggy-effect/no-inline-schema-compile": "error",
    "ziggy-effect/no-instanceof-error": "error",
    "ziggy-effect/no-instanceof-tagged-error": "error",
    "ziggy-effect/no-json-parse": "error",
    "ziggy-effect/no-match-orelse": "error",
    "ziggy-effect/no-native-promise-ownership": "error",
    "ziggy-effect/no-promise-catch": "error",
    "ziggy-effect/no-raw-fetch": "error",
    "ziggy-effect/no-try-catch-or-throw": "error",
    "ziggy-effect/no-ts-nocheck": "error",
    "ziggy-effect/no-unsupported-effect-api": "error",
    "ziggy-effect/prefer-yield-tagged-error": "error",
    "ziggy/no-chained-type-assertions": "error",
    "ziggy/no-conditional-empty-object-spread": "error",
    "ziggy/no-known-value-widening": "error",
    "ziggy/no-module-mocking": "error",
    "ziggy/no-object-parameters": "error",
    "ziggy/no-reflect-apply": "error",
    "ziggy/no-reflect-get": "error",
    "ziggy/no-runtime-typeof": "error",
    "ziggy/no-shape-in-symbol-names": "error",
    "ziggy/no-unknown-parameters": "error",
    "ziggy/no-unknown-returns": "error",
    "ziggy/no-unknown-type-aliases": "error",
    "ziggy/no-unsafe-dictionary-type": "error",
    "ziggy/no-unsafe-typescript-syntax": "error",
    "ziggy/no-widen-then-assert": "error",
    "ziggy/require-safety-comment-for-type-assertion": "error"
  }
}
