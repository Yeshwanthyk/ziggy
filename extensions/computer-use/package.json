{
  "name": "@ziggy/computer-use",
  "version": "0.5.0",
  "private": true,
  "description": "Semantic desktop and browser control through the pinned pi-computer-use runtime.",
  "keywords": [
    "accessibility",
    "computer-use",
    "desktop-automation",
    "linux",
    "macos",
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/injaneity/pi-computer-use#readme",
  "bugs": {
    "url": "https://github.com/injaneity/pi-computer-use/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/injaneity/pi-computer-use.git"
  },
  "files": [
    "dist",
    "scripts/build-native.mjs",
    "scripts/setup-helper.mjs",
    "native/macos/bridge.swift",
    "native/windows/bridge-rs/Cargo.lock",
    "native/windows/bridge-rs/Cargo.toml",
    "native/windows/bridge-rs/src",
    "native/windows/bridge-rs/tests",
    "prebuilt/macos",
    "prebuilt/windows",
    "assets/reference/img.jpg",
    "README.md",
    "LICENSE",
    "native/linux/bridge-rs",
    "prebuilt/linux",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./test",
    "build:native": "node scripts/build-native.mjs",
    "build:windows": "node scripts/build-native.mjs --platform windows",
    "build:linux": "node scripts/build-native.mjs --platform linux"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.7"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "./assets/reference/img.jpg"
  }
}
