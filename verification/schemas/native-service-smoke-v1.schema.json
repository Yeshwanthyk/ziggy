{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziggy.local/verification/native-service-smoke-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "platform",
    "startedAt",
    "finishedAt",
    "git",
    "toolingInputDigest",
    "toolVersions",
    "capabilities",
    "steps",
    "cleanup",
    "replay",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "native-service-smoke" },
    "runId": { "type": "string", "pattern": "^native-service-smoke-[0-9]{8}T[0-9]{6}Z$" },
    "platform": { "enum": ["darwin", "linux"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "toolingInputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "toolVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bun", "git", "typescript", "host"],
      "properties": {
        "bun": { "type": "string", "minLength": 1, "maxLength": 128 },
        "git": { "type": "string", "minLength": 1, "maxLength": 128 },
        "typescript": { "type": "string", "minLength": 1, "maxLength": 128 },
        "host": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["darwin", "linux"],
      "properties": {
        "darwin": { "$ref": "#/$defs/darwinCapabilities" },
        "linux": { "$ref": "#/$defs/linuxCapabilities" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": { "$ref": "#/$defs/step" }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "nativeUnregister",
        "definitionRemoved",
        "disposableWorkspaceRemoved",
        "finishedAt"
      ],
      "properties": {
        "attempted": { "const": true },
        "nativeUnregister": { "enum": ["passed", "failed", "not-needed"] },
        "definitionRemoved": { "type": "boolean" },
        "disposableWorkspaceRemoved": { "type": "boolean" },
        "finishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "requirements", "instructions"],
      "properties": {
        "command": {
          "type": "array",
          "const": ["bun", "run", "native-service:smoke"]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "result": { "enum": ["passed", "failed"] }
  },
  "$defs": {
    "availability": { "enum": ["available", "missing", "not-probed"] },
    "disposition": { "enum": ["available", "unavailable-on-host", "unsupported"] },
    "darwinCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "launchd", "plutil"],
      "properties": {
        "disposition": { "$ref": "#/$defs/disposition" },
        "launchd": { "$ref": "#/$defs/availability" },
        "plutil": { "$ref": "#/$defs/availability" }
      }
    },
    "linuxCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "systemctl",
        "systemdAnalyze",
        "loginctl",
        "userManager",
        "lingering"
      ],
      "properties": {
        "disposition": { "$ref": "#/$defs/disposition" },
        "systemctl": { "$ref": "#/$defs/availability" },
        "systemdAnalyze": { "$ref": "#/$defs/availability" },
        "loginctl": { "$ref": "#/$defs/availability" },
        "userManager": { "enum": ["available", "unavailable", "not-probed"] },
        "lingering": { "enum": ["enabled", "disabled", "unknown", "not-probed"] }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "digest", "truncated"],
      "properties": {
        "text": { "type": "string", "maxLength": 2048 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "truncated": { "type": "boolean" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "startedAt",
        "finishedAt",
        "exitCode",
        "timedOut",
        "result",
        "diagnostic"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "exitCode": { "type": "integer" },
        "timedOut": { "type": "boolean" },
        "result": { "enum": ["passed", "failed"] },
        "diagnostic": { "$ref": "#/$defs/diagnostic" }
      }
    }
  }
}
