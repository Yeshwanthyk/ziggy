{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziggy.local/verification/scenario-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "stage", "file", "seed", "schedule", "boundaryConfiguration"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^s[0-7]\\.[a-z0-9-]+$" },
    "stage": { "enum": ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7"] },
    "file": {
      "type": "string",
      "pattern": "^tests/(?:[a-zA-Z0-9._-]+/)*[a-zA-Z0-9._-]+\\.test\\.ts$"
    },
    "seed": { "type": "string", "minLength": 1 },
    "schedule": { "type": "string", "minLength": 1 },
    "boundaryConfiguration": { "type": "string", "minLength": 1 }
  }
}
