{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziggy.local/verification/evidence-summary-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "command",
    "agentFindingsAttached",
    "scenarios",
    "startedAt",
    "finishedAt",
    "git",
    "toolVersions",
    "result",
    "phases",
    "commands"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7", "all"] },
    "command": { "type": "string", "minLength": 1 },
    "agentFindingsAttached": { "type": "boolean" },
    "scenarios": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" }
      }
    },
    "toolVersions": { "type": "object", "additionalProperties": { "type": "string" } },
    "result": { "enum": ["passed", "failed"] },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result", "startedAt", "finishedAt", "diagnostic"],
        "properties": {
          "name": { "enum": ["preflight", "gate", "scenario", "publication"] },
          "result": { "enum": ["passed", "failed", "not-run"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "diagnostic": { "type": "string", "maxLength": 8192 }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic", "diagnosticDigest", "truncated"],
      "properties": {
        "diagnostic": { "type": "string", "maxLength": 8192 },
        "diagnosticDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "truncated": { "type": "boolean" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "exitCode", "timedOut", "stdout", "stderr"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exitCode": { "type": "integer" },
        "timedOut": { "type": "boolean" },
        "stdout": { "$ref": "#/$defs/output" },
        "stderr": { "$ref": "#/$defs/output" }
      }
    }
  }
}
