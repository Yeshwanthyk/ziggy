{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ziggy.local/verification/s4-merlin-migration-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpus", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "candidateCount",
        "regularFileCount",
        "totalBytes",
        "inventoryDigest",
        "digestAlgorithm"
      ],
      "properties": {
        "relativePath": { "const": "../merlin/extensions" },
        "candidateCount": { "const": 47 },
        "regularFileCount": { "const": 175 },
        "totalBytes": { "const": 17631635 },
        "inventoryDigest": {
          "const": "e629623273623eb3672adbe0523a33d2bab275dcdabf8abe75cdd38a9921b791"
        },
        "digestAlgorithm": { "type": "string", "minLength": 1 }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^extensions/[a-z0-9-]+/(?:[^./][^/]*/)*[^./][^/]*$"
        },
        "kind": { "enum": ["manifest", "skill", "tool", "cli", "support"] },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "id", "ownerStage", "trustTier", "executionMode"],
          "properties": {
            "mechanism": { "const": "extension" },
            "id": { "$ref": "#/$defs/identifier" },
            "ownerStage": { "enum": ["s4", "s7"] },
            "trustTier": { "enum": ["builtin", "verified", "community"] },
            "executionMode": { "enum": ["skill-only", "supervised-command", "define-tool"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "id", "ownerStage"],
          "properties": {
            "mechanism": { "const": "core-skill" },
            "id": { "$ref": "#/$defs/identifier" },
            "ownerStage": { "const": "s4" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "id", "ownerStage"],
          "properties": {
            "mechanism": { "const": "blueprint" },
            "id": { "$ref": "#/$defs/identifier" },
            "ownerStage": { "const": "s4" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "id", "ownerStage"],
          "properties": {
            "mechanism": { "const": "automation" },
            "id": { "$ref": "#/$defs/identifier" },
            "ownerStage": { "const": "s5" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "id", "ownerStage"],
          "properties": {
            "mechanism": { "const": "gateway" },
            "id": { "$ref": "#/$defs/identifier" },
            "ownerStage": { "enum": ["s6", "s7"] }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "overlap",
        "dependencies",
        "permissions",
        "stateAuthority",
        "disposition",
        "rationale",
        "target",
        "excludedCapabilities",
        "leannessEvidence",
        "deliveryStatus"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["userOutcome", "evidence"],
          "properties": {
            "userOutcome": { "$ref": "#/$defs/nonEmpty" },
            "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
          }
        },
        "overlap": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["with", "relationship", "rationale"],
            "properties": {
              "with": { "$ref": "#/$defs/identifier" },
              "relationship": { "$ref": "#/$defs/nonEmpty" },
              "rationale": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "rationale"],
            "properties": {
              "kind": { "enum": ["external", "runtime", "system", "ziggy"] },
              "name": { "$ref": "#/$defs/nonEmpty" },
              "rationale": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network", "filesystem", "secrets", "subprocesses", "externalAuthorities"],
          "properties": {
            "network": { "type": "boolean" },
            "filesystem": { "enum": ["none", "profile", "full"] },
            "secrets": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonEmpty" }
            },
            "subprocesses": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonEmpty" }
            },
            "externalAuthorities": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        },
        "stateAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "persistedPaths", "rationale"],
          "properties": {
            "owner": { "enum": ["none", "ziggy", "external"] },
            "persistedPaths": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scope", "path", "authority"],
                "properties": {
                  "scope": { "enum": ["profile", "extension-state", "external"] },
                  "path": { "$ref": "#/$defs/nonEmpty" },
                  "authority": { "$ref": "#/$defs/nonEmpty" }
                }
              }
            },
            "rationale": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "disposition": {
          "enum": ["port", "merge", "blueprint", "defer-to-S5", "defer-to-S6/S7", "drop"]
        },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "target": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/target" }] },
        "excludedCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "leannessEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "deliveryStatus": { "enum": ["not-applicable", "planned", "landed"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "drop" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "target": { "type": "null" },
              "deliveryStatus": { "const": "not-applicable" }
            }
          },
          "else": {
            "properties": {
              "target": { "$ref": "#/$defs/target" },
              "deliveryStatus": { "enum": ["planned", "landed"] }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "blueprint" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "target": {
                "type": "object",
                "properties": {
                  "mechanism": { "const": "blueprint" },
                  "ownerStage": { "const": "s4" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "defer-to-S5" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "target": {
                "type": "object",
                "properties": {
                  "mechanism": { "const": "automation" },
                  "ownerStage": { "const": "s5" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "defer-to-S6/S7" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "target": {
                "type": "object",
                "properties": { "ownerStage": { "enum": ["s6", "s7"] } }
              }
            }
          }
        }
      ]
    }
  }
}
