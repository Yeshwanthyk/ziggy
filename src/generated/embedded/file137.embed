{
  "name": "@ziggy/dev-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Profile-scoped persistent browser automation through dev-browser.",
  "keywords": ["browser-automation", "pi-extension", "pi-package"],
  "license": "MIT",
  "scripts": {
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint index.ts test",
    "fmt": "oxfmt index.ts test"
  },
  "pi": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.7"
  }
}
