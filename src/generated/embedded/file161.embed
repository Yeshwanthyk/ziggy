/* View kit: the plugin's controls and states. Colours, fonts and radii come from the host's MCP Apps
   style variables, with light/dark fallbacks for hosts that send none. Style new things with these
   tokens and kit classes; don't hard-code colours. Copied into each plugin: edit freely. */
:root {
  color-scheme: light dark;
  --kit-bg: var(--color-background-primary, light-dark(#fff, #18181b));
  --kit-bg-muted: var(--color-background-secondary, light-dark(#f4f4f5, #27272a));
  --kit-fg: var(--color-text-primary, light-dark(#18181b, #fafafa));
  --kit-fg-muted: var(--color-text-secondary, light-dark(#52525b, #a1a1aa));
  --kit-border: var(--color-border-primary, light-dark(#d4d4d8, #3f3f46));
  --kit-accent-bg: var(--color-background-inverse, light-dark(#18181b, #fafafa));
  --kit-accent-fg: var(--color-text-inverse, light-dark(#fafafa, #18181b));
  --kit-danger: var(--color-text-danger, light-dark(#b91c1c, #f87171));
  --kit-danger-bg: var(--color-background-danger, light-dark(#fef2f2, #3b1414));
  --kit-success: var(--color-text-success, light-dark(#15803d, #4ade80));
  --kit-success-bg: var(--color-background-success, light-dark(#f0fdf4, #12291b));
  --kit-warning: var(--color-text-warning, light-dark(#a16207, #facc15));
  --kit-warning-bg: var(--color-background-warning, light-dark(#fefce8, #2c2510));
  --kit-ring: var(--color-ring-primary, light-dark(#2563eb, #60a5fa));
  --kit-radius: var(--border-radius-md, 8px);
  --kit-font: var(--font-sans, system-ui, sans-serif);
  --kit-target: 36px;
}
@media (pointer: coarse) {
  :root {
    --kit-target: 44px;
  }
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  padding: 12px;
  background: var(--kit-bg);
  color: var(--kit-fg);
  font: var(--font-text-md-size, 14px) / 1.4 var(--kit-font);
  overflow-wrap: anywhere;
}
:focus-visible {
  outline: 2px solid var(--kit-ring);
  outline-offset: 2px;
}

/* Layout */
.kit-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.kit-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}
.kit-grow {
  flex: 1 1 12rem;
  min-width: 0;
}
.kit-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
}
.kit-toolbar .kit-more {
  display: none;
}
@media (max-width: 479px) {
  .kit-toolbar .kit-folds {
    display: none;
  }
  .kit-toolbar .kit-more {
    display: inline-block;
  }
}

/* Controls */
.kit-button,
.kit-input,
.kit-menu {
  min-height: var(--kit-target);
  padding: 6px 12px;
  border: 1px solid var(--kit-border);
  border-radius: var(--kit-radius);
  font: inherit;
  color: var(--kit-fg);
  background: var(--kit-bg);
}
.kit-button {
  min-width: var(--kit-target);
  background: var(--kit-bg-muted);
  cursor: pointer;
  white-space: nowrap;
}
.kit-button.primary {
  background: var(--kit-accent-bg);
  color: var(--kit-accent-fg);
  border-color: transparent;
}
.kit-button.danger {
  color: var(--kit-danger);
}
.kit-button.armed {
  background: var(--kit-danger-bg);
  color: var(--kit-danger);
  border-color: var(--kit-danger);
}
.kit-button:disabled {
  opacity: 0.5;
  cursor: default;
}
.kit-input {
  width: 100%;
  min-width: 0;
}
.kit-menu {
  cursor: pointer;
}
.kit-check {
  width: 20px;
  height: 20px;
  margin: calc((var(--kit-target) - 20px) / 2);
  accent-color: var(--kit-accent-bg);
}
.kit-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
  color: var(--kit-fg-muted);
  font-size: 0.9em;
}
.kit-tag {
  display: inline-block;
  padding: 1px 8px;
  border-radius: 999px;
  background: var(--kit-bg-muted);
  color: var(--kit-fg-muted);
  font-size: 0.85em;
  white-space: nowrap;
}
.kit-tag.success {
  background: var(--kit-success-bg);
  color: var(--kit-success);
}
.kit-tag.warning {
  background: var(--kit-warning-bg);
  color: var(--kit-warning);
}
.kit-tag.danger {
  background: var(--kit-danger-bg);
  color: var(--kit-danger);
}

/* Lists */
.kit-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.kit-list > li {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 8px;
  padding: 4px 0;
  border-bottom: 1px solid var(--kit-border);
}
.kit-list .kit-title {
  flex: 1 1 8rem;
  min-width: 0;
}
.kit-muted,
.kit-list > li.done .kit-title {
  color: var(--kit-fg-muted);
}
.kit-list > li.done .kit-title {
  text-decoration: line-through;
}

/* States */
.kit-status {
  margin: 0;
  color: var(--kit-fg-muted);
}
.kit-status:empty {
  display: none;
}
.kit-status.error {
  color: var(--kit-danger);
}
.kit-notice {
  padding: 16px;
  border: 1px dashed var(--kit-border);
  border-radius: var(--kit-radius);
  color: var(--kit-fg-muted);
  text-align: center;
}
.kit-notice.error {
  border-style: solid;
  border-color: var(--kit-danger);
  color: var(--kit-danger);
}
.kit-notice .kit-button {
  margin-top: 8px;
}
.kit-skeleton {
  height: var(--kit-target);
  margin: 4px 0;
  border-radius: var(--kit-radius);
  background: var(--kit-bg-muted);
  animation: kit-pulse 1.2s ease-in-out infinite;
}
@keyframes kit-pulse {
  50% {
    opacity: 0.5;
  }
}
@media (prefers-reduced-motion: reduce) {
  .kit-skeleton {
    animation: none;
  }
}
