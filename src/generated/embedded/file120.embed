{
  "name": "@ziggy/computer-workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Record, verify, save, and run adaptable computer-use tasks and reviewed semantic workflows.",
  "keywords": ["pi-package", "computer-use", "workflows"],
  "scripts": {
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint index.ts src test",
    "fmt": "oxfmt index.ts src test skills"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.7"
  },
  "pi": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  }
}
