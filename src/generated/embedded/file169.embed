{
  "name": "@ziggy/web-search",
  "version": "0.1.0",
  "private": true,
  "description": "Exa-backed web search and public URL fetching for Pi.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint index.ts fetch-url.ts bin test",
    "fmt": "oxfmt index.ts fetch-url.ts bin test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "typebox": "1.3.27"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
