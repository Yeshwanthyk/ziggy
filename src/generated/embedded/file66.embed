{
  "name": "@ziggy/lossless-claw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lossless Claw recall tools for persisted Pi sessions.",
  "keywords": ["pi-package"],
  "scripts": {
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint index.ts src test",
    "fmt": "oxfmt index.ts src test"
  },
  "pi": {
    "extensions": ["./index.ts"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "effect": "4.0.0-beta.99",
    "typebox": "1.3.7"
  }
}
