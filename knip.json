{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "test/**/*.test.ts",
    "test/harness/sandbox.ts",
    "test/harness/device-cli.ts",
    "test/platform/noise-interop.ts",
    "extensions/*/index.ts",
    "extensions/*/bin/**/*.{ts,mjs}",
    "extensions/*/test/**/*.test.ts",
    "clients/web/src/main.tsx",
    "clients/web/src/**/*.test.ts",
    "clients/web/src/**/*.test.tsx",
    "clients/web/vite.config.ts",
    "packages/ui-sdk/src/index.ts",
    "packages/ui-sdk/test/**/*.test.ts",
    "packages/device/src/index.ts",
    "packages/device/bin/ziggy-device.ts",
    "packages/device/test/**/*.test.ts",
    "tooling/generate-*.mjs",
    "tooling/oxlint/*-plugin.mjs",
    "tooling/**/*.test.ts",
    "test/extensions/fixtures/*.ts",
    "src/extensions/codemode/worker.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts",
    "extensions/**/*.{ts,mjs}",
    "clients/**/*.{ts,tsx}",
    "tooling/**/*.{ts,mjs}"
  ],
  "ignore": [
    "extensions/computer-use/dist/**",
    "extensions/computer-use/scripts/**",
    "extensions/device-authoring/skills/device-authoring/template/**",
    "extensions/plugin-authoring/skills/plugin-authoring/template/**",
    "clients/web/src/vendor/bloub/**"
  ],
  "include": [
    "files",
    "exports",
    "types"
  ]
}
